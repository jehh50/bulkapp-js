{
  "name": "bulkapp",
  "private": true,
  "version": "2.0.0",
  "description": "BulkApp — CRM / call center (API Node.js + React)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @bulkapp/api",
    "dev:web": "npm run dev -w @bulkapp/web",
    "build": "npm run build -w @bulkapp/web",
    "start": "npm run start -w @bulkapp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @bulkapp/api",
    "db:migrate": "npm run db:migrate -w @bulkapp/api",
    "db:seed": "npm run db:seed -w @bulkapp/api",
    "db:importar-mysql": "npm run db:importar-mysql -w @bulkapp/api --"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
