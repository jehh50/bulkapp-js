    "db:importar-mysql": "node scripts/importar-mysql.ts"
  },
  "dependencies": {
    "@bulkapp/shared": "*",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "mysql2": "^3.15.0",
    "prisma": "^6.19.0",
    "typescript": "~5.9.0"
  }
}
