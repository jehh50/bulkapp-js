# Copiar a .env y completar. Nunca versionar el archivo .env.
NODE_ENV=development
PORT=4000
# Zona horaria de negocio (fechas de gestión, reportes y XML).
APP_TZ=America/Caracas
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/bulkapp?schema=public"
# Secretos distintos, de 32+ caracteres (p. ej. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Vida del token de acceso (s) y timeout de sesión por inactividad (s, mínimo 300).
JWT_ACCESS_TTL=900
SESSION_IDLE_TIMEOUT=1800
# Origen de la web en desarrollo (Vite). En producción la API sirve la web.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Carpeta de archivos generados (XML). Relativa a apps/api.
STORAGE_DIR=../../storage
# Solo para `npm run db:seed`: clave inicial del administrador.
SEED_ADMIN_PASSWORD=
# Solo para `npm run db:importar-mysql`: BD MySQL de origen.
# Origen de `npm run db:importar-mysql` (base MySQL de la aplicación PHP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_NAME=
